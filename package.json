{
  "name": "claude-hook-gate",
  "version": "0.22.0",
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.317",
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/picomatch": "4.0.3",
    "i18next": "26.7.1",
    "picomatch": "4.0.7",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "description": "feedback-gate: Claude Code function hooks for feedback rules and per-project quality gates",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.src.json",
    "test": "bun test --parallel --timeout 30000 tests",
    "test:plugin": "bun run build && claude plugin test .",
    "validate:plugin": "claude plugin validate . --strict",
    "build": "bun scripts/build.ts"
  },
  "type": "module"
}
