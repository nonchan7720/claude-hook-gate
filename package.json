{
  "name": "claude-hook-gate",
  "version": "0.0.0",
  "private": true,
  "description": "feedback-gate: Claude Code function hooks for feedback rules and per-project quality gates",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.src.json",
    "test": "bun test tests",
    "test:plugin": "bun run build && claude plugin test .",
    "build": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "picomatch": "^4.0.7",
    "typescript": "^5.8.0",
    "yaml": "^2.9.1"
  }
}
