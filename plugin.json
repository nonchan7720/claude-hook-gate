{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "feedback-gate",
  "version": "0.14.1",
  "description": "Codex hooks that inject feedback rules, enforce them on tool calls and at stop time, and run per-project quality gates defined in .agents/gate.yaml",
  "author": {
    "name": "nonchan7720"
  },
  "homepage": "https://github.com/nonchan7720/claude-hook-gate",
  "repository": "https://github.com/nonchan7720/claude-hook-gate",
  "license": "MIT",
  "keywords": [
    "codex",
    "hooks",
    "feedback",
    "quality-gate"
  ],
  "extensions": {
    "com.openai": {
      "hooks": "./plugins/codex/hooks/hooks.json"
    }
  }
}
